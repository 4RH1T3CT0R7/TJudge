# TJudge Performance Profile: MEDIUM
# Target: 4 CPU cores, 8 GB RAM
# Use case: Standard server, mid-tier VPS, modern workstation
#
# Usage: make deploy-medium
# (scripts/quick-deploy.sh передаёт файл в docker-compose.selfhosted.yml через --env-file)

# =============================================================================
# WORKER POOL
# =============================================================================
# одновременных матчей; каждый получает EXECUTOR_CPU_QUOTA, сумма не больше ядер
WORKER_MIN=2
WORKER_MAX=4
# EXECUTOR_TIMEOUT + 30s: запас на запуск контейнера и запись результата
WORKER_TIMEOUT=90s

# =============================================================================
# EXECUTOR (Match execution)
# =============================================================================
# 512 MiB per container - standard allocation
EXECUTOR_MEMORY_LIMIT=536870912
# 100% of one CPU core
EXECUTOR_CPU_QUOTA=100000
EXECUTOR_PIDS_LIMIT=100
EXECUTOR_TIMEOUT=60s

# =============================================================================
# DATABASE
# =============================================================================
# на api и на worker каждому: вместе 2 x 30 из 100 соединений postgres
DB_MAX_CONNECTIONS=30
DB_MAX_IDLE=5

# =============================================================================
# REDIS
# =============================================================================
REDIS_POOL_SIZE=50
REDIS_MAXMEMORY=512mb

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=100
