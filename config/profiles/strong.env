# TJudge Performance Profile: STRONG
# Target: 8+ CPU cores, 16+ GB RAM
# Use case: Dedicated server, high-tier VPS, production deployment
#
# Usage: make deploy-strong
# (scripts/quick-deploy.sh передаёт файл в docker-compose.selfhosted.yml через --env-file)

# =============================================================================
# WORKER POOL
# =============================================================================
# одновременных матчей; каждый получает EXECUTOR_CPU_QUOTA, сумма не больше ядер
WORKER_MIN=2
WORKER_MAX=8
# EXECUTOR_TIMEOUT + 30s: запас на запуск контейнера и запись результата
WORKER_TIMEOUT=90s

# =============================================================================
# EXECUTOR (Match execution)
# =============================================================================
# 1 GiB per container - generous allocation for complex programs
EXECUTOR_MEMORY_LIMIT=1073741824
# 100% of one CPU core, as in prod
EXECUTOR_CPU_QUOTA=100000
EXECUTOR_PIDS_LIMIT=200
EXECUTOR_TIMEOUT=60s

# =============================================================================
# DATABASE
# =============================================================================
# на api и на worker каждому: вместе 2 x 40 из 100 соединений postgres
DB_MAX_CONNECTIONS=40
DB_MAX_IDLE=10

# =============================================================================
# REDIS
# =============================================================================
REDIS_POOL_SIZE=100
REDIS_MAXMEMORY=1gb

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=200
