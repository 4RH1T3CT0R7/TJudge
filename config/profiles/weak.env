# TJudge Performance Profile: WEAK
# Target: 2 CPU cores, 4 GB RAM
# Use case: Old laptop, entry-level VPS, development machine
#
# Usage: make deploy-weak
# (scripts/quick-deploy.sh передаёт файл в docker-compose.selfhosted.yml через --env-file)

# =============================================================================
# WORKER POOL
# =============================================================================
# одновременных матчей; каждый получает EXECUTOR_CPU_QUOTA, сумма не больше ядер
WORKER_MIN=1
WORKER_MAX=3
# EXECUTOR_TIMEOUT + 30s: запас на запуск контейнера и запись результата
WORKER_TIMEOUT=120s

# =============================================================================
# EXECUTOR (Match execution)
# =============================================================================
# 256 MiB per container - reduced to allow more parallel matches on limited RAM
EXECUTOR_MEMORY_LIMIT=268435456
# 50% of one CPU core - leaves room for system processes
EXECUTOR_CPU_QUOTA=50000
EXECUTOR_PIDS_LIMIT=50
EXECUTOR_TIMEOUT=90s

# =============================================================================
# DATABASE
# =============================================================================
# на api и на worker каждому: вместе 2 x 15 из 100 соединений postgres
DB_MAX_CONNECTIONS=15
DB_MAX_IDLE=5

# =============================================================================
# REDIS
# =============================================================================
REDIS_POOL_SIZE=30
REDIS_MAXMEMORY=256mb

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=50
