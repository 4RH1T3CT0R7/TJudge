# TJudge Configuration
# Скопируйте этот файл в .env и настройте под ваше окружение
# cp .env.example .env

# ============================================================================
# ОКРУЖЕНИЕ
# ============================================================================

# Режим работы: development | production
ENVIRONMENT=development

# ============================================================================
# API SERVER
# ============================================================================

# Порт API сервера
API_PORT=8080

# Таймауты
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s

# Базовый URL приложения (для генерации ссылок)
BASE_URL=http://localhost:8080

# ============================================================================
# POSTGRESQL
# ============================================================================

# Хост базы данных
# Docker: postgres | Локально: localhost
DB_HOST=localhost

# Порт (5433 чтобы не конфликтовать с локальным PostgreSQL)
DB_PORT=5433

# Учётные данные (в production пароль лучше через DB_PASSWORD_FILE - docker secrets)
DB_USER=tjudge
DB_PASSWORD=secret
DB_NAME=tjudge

# disable | require | verify-full
DB_SSLMODE=disable

# Пул соединений (по умолчанию считается от WORKER_MAX, не больше 100)
DB_MAX_CONNECTIONS=50
DB_MAX_IDLE=10
DB_MAX_LIFETIME=5m

# ============================================================================
# REDIS
# ============================================================================

# Хост Redis
# Docker: redis | Локально: localhost
REDIS_HOST=localhost
REDIS_PORT=6379

# Пароль (оставьте пустым если не используется; или REDIS_PASSWORD_FILE)
REDIS_PASSWORD=

# Номер базы данных
REDIS_DB=0

# Размер пула соединений (фактически не меньше WORKER_MAX + 20)
REDIS_POOL_SIZE=100

# ============================================================================
# WORKER POOL
# ============================================================================

# Минимальное и максимальное количество воркеров.
# По умолчанию WORKER_MAX = число ядер, WORKER_MIN = min(2, WORKER_MAX)
#WORKER_MIN=2
#WORKER_MAX=8

# Как часто автоскейлер проверяет пул
#WORKER_AUTOSCALE_INTERVAL=2s

# Таймаут обработки одного матча, не меньше EXECUTOR_TIMEOUT + 20s (проверяется на старте).
# У api и worker должен совпадать: от него считается порог зависшего матча
WORKER_TIMEOUT=60s

# Повторные попытки при ошибке
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=5s

# ============================================================================
# MATCH EXECUTOR (Docker)
# ============================================================================

# Образ исполнителя матчей (make docker-build-executor)
EXECUTOR_DOCKER_IMAGE=tjudge-cli:latest

# Таймаут выполнения матча
EXECUTOR_TIMEOUT=30s

# Лимиты ресурсов для контейнера (сети у матч-контейнера нет всегда).
# CPU_QUOTA - микросекунды на 100ms, MEMORY_LIMIT - байты, не меньше 6 МиБ
EXECUTOR_CPU_QUOTA=100000
EXECUTOR_MEMORY_LIMIT=536870912
EXECUTOR_PIDS_LIMIT=100

# Итераций в матче (tjudge-cli -i), не меньше 1
EXECUTOR_DEFAULT_ITERATIONS=100

# Подробный вывод tjudge-cli (-v)
#EXECUTOR_VERBOSE=false

# Привязка матч-контейнеров к ядрам, например 0-3
#EXECUTOR_CPUSET_CPUS=

# Образ-песочница для компиляции загруженных программ (make docker-build-builder)
EXECUTOR_BUILDER_IMAGE=tjudge-builder:latest

# Таймаут компиляции одной программы
EXECUTOR_COMPILE_TIMEOUT=120s

# Параллельных сборок на одну реплику worker'а
EXECUTOR_COMPILE_WORKERS=2

# Путь внутри worker'а к seccomp-профилю матч-контейнера (например,
# смонтированный deployments/security/seccomp-executor.json). файл читается
# на старте, нечитаемый или битый JSON - worker не стартует
#EXECUTOR_SECCOMP_PROFILE=

# Имя AppArmor-профиля, загруженного на хосте (deployments/security/apparmor-executor
# объявляет tjudge-executor)
#EXECUTOR_APPARMOR_PROFILE=

# ============================================================================
# TELEGRAM (off-site бэкапы и алерты)
# ============================================================================

# Токен бота (@BotFather) и chat_id для доставки бэкапов (scripts/backup.sh).
# Для алертов Alertmanager токен дополнительно кладётся в файл
# deployments/alertmanager/telegram_token (см. deployments/alertmanager/alertmanager.yml).
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# ============================================================================
# RETENTION ПАРТИЦИЙ
# ============================================================================

# Сколько месяцев хранить партиции matches/rating_history.
# 0 (по умолчанию) - retention выключен, данные не удаляются.
DB_PARTITION_RETENTION_MONTHS=0

# ============================================================================
# STORAGE
# ============================================================================

# Путь для хранения загруженных программ
# Docker: /data/programs | Локально: ./data/programs
PROGRAMS_PATH=/data/programs

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================

# В production не короче 32 байт и не заглушка, иначе старт упадёт (или JWT_SECRET_FILE)
JWT_SECRET=your-secret-key-change-in-production

# Время жизни токенов
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h

# ============================================================================
# LOGGING
# ============================================================================

# Уровень: debug | info | warn | error
LOG_LEVEL=info

# Формат: json | console
LOG_FORMAT=json

# Асинхронное логирование (true для высокой нагрузки)
LOG_ASYNC=false

# ============================================================================
# METRICS (Prometheus)
# ============================================================================

# Включить метрики
METRICS_ENABLED=true

# Порт отдельного сервера метрик (/metrics)
METRICS_PORT=9090

# ============================================================================
# TRACING (OpenTelemetry)
# ============================================================================

# Без endpoint трейсинг выключен. Семплирование: 1 - все трейсы, 0 - ни одного,
# любое другое значение или пусто - 10%
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_TRACES_SAMPLER_ARG=1

# ============================================================================
# CORS
# ============================================================================

# Разрешённые источники (* для всех в development)
CORS_ALLOWED_ORIGINS=*

# Время кэширования preflight запросов
CORS_MAX_AGE=3600

# ============================================================================
# WEBSOCKET
# ============================================================================

# Разрешённые источники для WebSocket (через запятую).
# Если не задано, берётся из CORS_ALLOWED_ORIGINS. В production пусто или "*"
# означает только свой хост (хост из Origin равен Host запроса)
WEBSOCKET_ALLOWED_ORIGINS=

# ============================================================================
# RATE LIMITING
# ============================================================================

# Включить rate limiting (только /api/v1)
RATE_LIMIT_ENABLED=false

# Запросов в минуту на пользователя (или IP без токена); GET/HEAD - отдельно,
# лимит x10; логин, регистрация и вступление в команду - отдельно по IP
RATE_LIMIT_RPM=1000

# CIDR прокси (через запятую), по которым разбирается X-Forwarded-For.
# Пусто - от соседа из loopback/приватной сети (nginx в docker-сети) берётся
# только X-Real-IP. Непустой список заменяет приватные сети целиком: в него
# входят и подсеть docker-сети nginx (в prod 172.28.0.0/16), и диапазоны
# внешнего прокси (Cloudflare и т.п.), иначе все клиенты считаются с его адреса
TRUSTED_PROXIES=

# ============================================================================
# DOCKER-COMPOSE SPECIFIC
# ============================================================================

# Absolute path to programs dir on the Docker host (for worker volume mounts)
HOST_PROGRAMS_PATH=./data/programs

# Redis max memory (used in docker-compose redis command)
REDIS_MAXMEMORY=512mb

# Grafana admin credentials
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# ============================================================================
# BACKUP
# ============================================================================

# Директория для бэкапов
BACKUP_DIR=./backups

# Срок хранения бэкапов (дней)
BACKUP_RETENTION_DAYS=7

# ============================================================================
# PERFORMANCE PROFILES
# ============================================================================
# Готовые наборы под железо: config/profiles/{weak,medium,strong}.env
# (make deploy-weak | make deploy-medium | make deploy-strong, см. docs/OPERATIONS.md §13)

# ============================================================================
# DOCTOR (scripts/doctor.sh - пост-деплойная диагностика)
# ============================================================================

# Режим мониторинга:
#   standalone - собственный стек TJudge (make monitoring-up)
#   external   - общий стек infra-monitoring скрейпит TJudge по сети monitoring
# Порты Prometheus (9092) и Pushgateway (9094) одинаковы в обоих режимах -
# doctor и дашборды работают без перенастройки.
#MONITORING_MODE=standalone

# Pushgateway для метрик doctor'а (дашборд «TJudge - Doctor» в Grafana).
# Пусто - push пропускается. Standalone и infra-monitoring: http://localhost:9094
#PUSHGATEWAY_URL=http://localhost:9094

# Отчёт в Telegram: auto (только при проблемах) | always | never
#DOCTOR_TELEGRAM=auto

# Окно анализа логов и порог ошибок до предупреждения
#DOCTOR_LOG_WINDOW=15m
#DOCTOR_LOG_ERROR_THRESHOLD=5

# Учётка админа для глубокой проверки (/system/status: БД, очереди, outbox).
# status.sh/doctor.sh сами получают свежий JWT на каждый запуск.
#ADMIN_USER=admin-login-or-email
#ADMIN_PASSWORD=
# Альтернатива: готовый JWT (истекает за JWT_ACCESS_TTL, в .env протухнет)
#ADMIN_TOKEN=

# GID группы docker на хосте - для доступа worker'а (non-root) к docker.sock.
# Узнать: getent group docker | cut -d: -f3
#DOCKER_SOCK_GID=999
